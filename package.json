{
  "name": "fluid-live-calling-platform",
  "private": true,
  "version": "1.0.6",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,FRONTEND\" -c \"cyan,magenta\" \"npm run server\" \"vite\"",
    "dev:ui": "vite",
    "server": "tsx watch backend/src/index.ts",
    "build": "prisma generate --schema=backend/prisma/schema.prisma && tsc && vite build && esbuild backend/src/index.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=api/index.js",
    "postinstall": "prisma generate --schema=backend/prisma/schema.prisma",
    "lint": "tsc --noEmit",
    "preview": "vite preview",
    "test:sanity": "tsx --env-file=.env tests/sanity/sanity_test_scheduler.ts",
    "test:workflows": "tsx --env-file=.env tests/sanity/audit_all_workflows.ts",
    "prisma:generate": "prisma generate --schema=backend/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=backend/prisma/schema.prisma",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio --schema=backend/prisma/schema.prisma"
  },
  "prisma": {
    "schema": "backend/prisma/schema.prisma",
    "seed": "tsx backend/prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@prisma/client": "5.22.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "esbuild": "^0.21.5",
    "postcss": "^8.4.47",
    "prisma": "5.22.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
